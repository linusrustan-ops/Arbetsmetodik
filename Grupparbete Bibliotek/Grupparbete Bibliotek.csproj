<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Grupparbete_Bibliotek</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BookDictionary.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Booklist.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Booklist.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="BookDictionary.cs" />
  </ItemGroup>

</Project>
